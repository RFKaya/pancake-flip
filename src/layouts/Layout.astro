---
import { ClientRouter } from 'astro:transitions';
import AppHeader from '../components/AppHeader.svelte';
import AppNav from '../components/AppNav.svelte';
import '../styles/app.css';
import { dilBul, yon } from '../lib/i18n';

interface Props {
  title?: string;
  tamEkran?: boolean;
  sahne?: boolean;
}

// sahne: üst başlık gizlenir, alt menü kalır (oyun sahnesi gibi açılan lobi için)
const { title = "Pancake Flip!", tamEkran = false, sahne = false } = Astro.props;
const currentPath = Astro.url.pathname;
const dil = dilBul(currentPath);
---

<!doctype html>
<html lang={dil} dir={yon(dil)}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <script is:inline>
      // Adım 15: Açılışta renk yanıp sönmesini engellemek için temayı anında uygula
      document.documentElement.dataset.tema =
        localStorage.getItem("tema") ??
        (matchMedia("(prefers-color-scheme: dark)").matches ? "gece" : "gunduz");
      // ClientRouter sayfa geçişinde <html> özelliklerini yeni sayfadan alır; yeni sayfada data-tema olmadığı için
      // tema kaybolur ve menü/oyun arasında renk değişir. Geçişten önce mevcut temayı yeni belgeye taşı.
      document.addEventListener("astro:before-swap", (e) => {
        e.newDocument.documentElement.dataset.tema = document.documentElement.dataset.tema;
      });
    </script>
    <ClientRouter />
  </head>
  <body class:list={{ 'tam-ekran': tamEkran }}>
    {!tamEkran && !sahne && <AppHeader client:load />}
    <main class:list={{ 'tam-ekran': tamEkran, sahne }}>
      <slot />
    </main>
    {!tamEkran && <AppNav client:load currentPath={currentPath} />}
  </body>
</html>

<style>
  main:not(.tam-ekran):not(.sahne) {
    padding-bottom: calc(80px + env(safe-area-inset-bottom));
    min-height: 100vh;
  }
</style>

<style is:global>
  body.tam-ekran {
    overflow: hidden;
    overscroll-behavior: none;
  }
</style>
