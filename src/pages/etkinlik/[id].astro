---
import Layout from '../../layouts/Layout.astro';
import EtkinlikDetay from '../../components/EtkinlikDetay.svelte';
import { etkinlikler, type Etkinlik } from '$lib/data';

export function getStaticPaths() {
  return etkinlikler.map((e) => ({
    params: { id: String(e.id) },
    props: { etkinlik: e },
  }));
}

interface Props {
  etkinlik: Etkinlik;
}

const { etkinlik } = Astro.props;
---

<Layout title={`${etkinlik.baslik} — Pancake Flip!`}>
  <EtkinlikDetay client:load etkinlik={etkinlik} />
</Layout>
